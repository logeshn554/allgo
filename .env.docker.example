# ==============================================================================
# AllGo Local Infrastructure Environment Template (.env.docker.example)
# Platform: Docker Compose (PostgreSQL 16 + PostGIS 3.4, Redis 7.0, ClamAV)
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL 16 + PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allgo_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/allgo_dev

# Redis 7.0 Cache & GEO Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Cryptographic Keys
JWT_SECRET=allgo_local_dev_jwt_secret_must_be_at_least_32_characters_long_for_security
OTP_PEPPER=allgo_local_dev_otp_pepper_secret_minimum_16_characters

# Payment Gateway (Razorpay Standard & Route Marketplace)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=local_test_razorpay_secret_key_12345

# Google Maps Platform (Routes, Geocoding, Places)
GOOGLE_MAPS_SERVER_API_KEY=local_test_google_maps_server_api_key
GOOGLE_MAPS_API_KEY=local_test_google_maps_server_api_key

# Firebase Admin SDK Credentials
FIREBASE_SERVICE_ACCOUNT_KEY=local_test_firebase_service_account_credentials_json_or_base64

# SMS & OTP Dispatch Gateway
SMS_GATEWAY_API_KEY=local_test_sms_gateway_api_key

# Google Cloud Storage (GCS) Document & Media Buckets
GCS_BUCKET_NAME=allgo-dev-private-documents

# Cloud KMS Customer-Managed Encryption Key
KMS_KEY_ID=projects/allgo-dev/locations/asia-south1/keyRings/allgo-ring/cryptoKeys/allgo-key
