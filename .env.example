# AllGo Production Environment Configuration

# Backend API & WebSocket Endpoint
EXPO_PUBLIC_API_URL=https://api.allgo.internal/v1
EXPO_PUBLIC_WS_URL=wss://api.allgo.internal/ws

# Database / Supabase REST
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Payment Gateways (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key

# Geospatial & Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key
