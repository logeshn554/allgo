{
  "name": "@allgo/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AllGo Multi-Vertical On-Demand Delivery and Mobility Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:common": "npm run build --workspace=@allgo/common",
    "build:api": "npm run build --workspace=@allgo/common && npm run build --workspace=@allgo/api",
    "build": "npm run build:api",
    "test": "node --experimental-transform-types --test tests/**/*.spec.ts",
    "test:workspace": "node --experimental-transform-types --test tests/workspace/*.spec.ts",
    "lint:openapi": "redocly lint docs/api/openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.75.0",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
