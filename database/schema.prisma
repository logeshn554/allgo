// ==============================================================================
// Prisma Schema for AllGo Multi-Vertical Super-App
// Engine: PostgreSQL 15 + PostGIS 3.x
// Scope: Relational & Spatial Entity Model
// ==============================================================================

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ------------------------------------------------------------------------------
// 1. Users, Roles & Devices
// ------------------------------------------------------------------------------

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone           String           @unique @db.VarChar(20)
  email           String?          @db.VarChar(255)
  fullName        String?          @map("full_name") @db.VarChar(255)
  status          String           @default("ACTIVE") @db.VarChar(32)
  firebaseUid     String           @unique @map("firebase_uid") @db.VarChar(128)
  defaultLanguage String           @default("en") @map("default_language") @db.VarChar(10)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles           UserRole[]
  devices         Device[]
  addresses       Address[]
  merchants       Merchant[]
  partners        Partner[]
  cart            Cart?
  checkoutSessions CheckoutSession[]
  orderGroups     OrderGroup[]
  wallet          Wallet?
  ratingsGiven    Rating[]
  supportTickets  SupportTicket[]
  assignedTickets SupportTicket[]  @relation("AssignedAdmin")
  auditLogs       AuditLog[]
  orderEvents     OrderEvent[]

  @@map("users")
}

model Role {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique @db.VarChar(32)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Device {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  deviceId         String   @map("device_id") @db.VarChar(128)
  fcmToken         String?  @map("fcm_token") @db.Text
  platform         String   @db.VarChar(32)
  refreshTokenHash String?  @map("refresh_token_hash") @db.VarChar(255)
  lastActiveAt     DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("devices")
}

model Address {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  label          String    @default("HOME") @db.VarChar(32)
  recipientName  String    @map("recipient_name") @db.VarChar(255)
  recipientPhone String    @map("recipient_phone") @db.VarChar(20)
  addressLine1   String    @map("address_line1") @db.Text
  addressLine2   String?   @map("address_line2") @db.Text
  landmark       String?   @db.Text
  city           String    @db.VarChar(100)
  state          String    @db.VarChar(100)
  postalCode     String    @map("postal_code") @db.VarChar(20)
  location       Unsupported("geometry(Point, 4326)")
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessions CheckoutSession[]
  orderGroups    OrderGroup[]

  @@map("addresses")
}

// ------------------------------------------------------------------------------
// 2. Geography, Service Zones & Waitlist
// ------------------------------------------------------------------------------

model State {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(10)
  stateCode       Int      @unique @map("state_code")
  name            String   @db.VarChar(100)
  status          String   @default("NOT_LAUNCHED") @db.VarChar(32)
  mobilityEnabled Boolean  @default(false) @map("mobility_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cities          City[]

  @@map("states")
}

model City {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateId   String       @map("state_id") @db.Uuid
  name      String       @db.VarChar(100)
  slug      String       @unique @db.VarChar(100)
  status    String       @default("NOT_LAUNCHED") @db.VarChar(32)
  timezone  String       @default("Asia/Kolkata") @db.VarChar(64)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  state     State        @relation(fields: [stateId], references: [id], onDelete: Restrict)
  settings  CitySetting?
  zones     Zone[]

  @@map("cities")
}

model CitySetting {
  id                               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId                           String   @unique @map("city_id") @db.Uuid
  modeBMaxMerchantDistanceKm       Decimal  @default(1.50) @map("mode_b_max_merchant_distance_km") @db.Decimal(6, 2)
  jitDispatchLeadTimeMinutes       Int      @default(7) @map("jit_dispatch_lead_time_minutes")
  unbatchingDelayThresholdMinutes  Int      @default(12) @map("unbatching_delay_threshold_minutes")
  checkoutQuoteTtlSeconds          Int      @default(600) @map("checkout_quote_ttl_seconds")
  modeBCustomerDiscountInr         Decimal  @default(25.00) @map("mode_b_customer_discount_inr") @db.Decimal(10, 2)
  modeBCourierExtraPickupInr       Decimal  @default(20.00) @map("mode_b_courier_extra_pickup_inr") @db.Decimal(10, 2)
  modeBMaxCombinedWeightKg         Decimal  @default(12.00) @map("mode_b_max_combined_weight_kg") @db.Decimal(6, 2)
  modeBMaxCombinedVolumeLiters     Decimal  @default(30.00) @map("mode_b_max_combined_volume_liters") @db.Decimal(6, 2)
  merchantAcceptTimeoutSeconds     Int      @default(180) @map("merchant_accept_timeout_seconds")
  customerCancelFreeWindowSeconds  Int      @default(60) @map("customer_cancel_free_window_seconds")
  surgeMultiplier                  Decimal  @default(1.00) @map("surge_multiplier") @db.Decimal(4, 2)
  platformFeeInr                   Decimal  @default(5.00) @map("platform_fee_inr") @db.Decimal(10, 2)
  createdAt                        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  city                             City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("city_settings")
}

model Zone {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(50)
  polygon   Unsupported("geometry(Polygon, 4326)")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  city      City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  outlets   Outlet[]

  @@unique([cityId, code])
  @@map("zones")
}

model WaitlistEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String   @db.VarChar(20)
  location   Unsupported("geometry(Point, 4326)")?
  postalCode String?  @map("postal_code") @db.VarChar(20)
  cityName   String?  @map("city_name") @db.VarChar(100)
  stateName  String?  @map("state_name") @db.VarChar(100)
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("waitlist_entries")
}

// ------------------------------------------------------------------------------
// 3. Merchants, Outlets & Catalogs
// ------------------------------------------------------------------------------

model Merchant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                String    @map("owner_id") @db.Uuid
  businessName           String    @map("business_name") @db.VarChar(255)
  tradeName              String?   @map("trade_name") @db.VarChar(255)
  merchantType           String    @map("merchant_type") @db.VarChar(32)
  panNumber              String    @map("pan_number") @db.VarChar(20)
  gstin                  String?   @db.VarChar(20)
  fssaiLicenseNumber     String?   @map("fssai_license_number") @db.VarChar(30)
  status                 String    @default("REGISTERED") @db.VarChar(32)
  bankAccountNumber      String?   @map("bank_account_number") @db.VarChar(50)
  bankIfsc               String?   @map("bank_ifsc") @db.VarChar(20)
  bankBeneficiaryName    String?   @map("bank_beneficiary_name") @db.VarChar(255)
  bankPennyDropVerified  Boolean   @default(false) @map("bank_penny_drop_verified")
  commissionRatePct      Decimal   @default(15.00) @map("commission_rate_percentage") @db.Decimal(5, 2)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                  User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  outlets                Outlet[]
  coupons                Coupon[]

  @@map("merchants")
}

model Outlet {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId             String    @map("merchant_id") @db.Uuid
  zoneId                 String    @map("zone_id") @db.Uuid
  outletName             String    @map("outlet_name") @db.VarChar(255)
  addressLine1           String    @map("address_line1") @db.Text
  addressLine2           String?   @map("address_line2") @db.Text
  postalCode             String    @map("postal_code") @db.VarChar(20)
  location               Unsupported("geometry(Point, 4326)")
  isOpen                 Boolean   @default(true) @map("is_open")
  defaultPrepTimeMinutes Int       @default(15) @map("default_prep_time_minutes")
  packagingFeeInr        Decimal   @default(10.00) @map("packaging_fee_inr") @db.Decimal(10, 2)
  phone                  String    @db.VarChar(20)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant               Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  zone                   Zone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  catalogs               Catalog[]
  inventory              Inventory[]
  cartItems              CartItem[]
  subOrders              SubOrder[]
  reservations           InventoryReservation[]

  @@map("outlets")
}

model Catalog {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId     String     @map("outlet_id") @db.Uuid
  name         String     @db.VarChar(255)
  verticalType String     @map("vertical_type") @db.VarChar(32)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet       Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  categories   Category[]

  @@map("catalogs")
}

model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogId    String   @map("catalog_id") @db.Uuid
  name         String   @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  catalog      Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  items        Item[]

  @@map("categories")
}

model Item {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId             String            @map("category_id") @db.Uuid
  sku                    String?           @db.VarChar(100)
  name                   String            @db.VarChar(255)
  description            String?           @db.Text
  basePriceInr           Decimal           @map("base_price_inr") @db.Decimal(10, 2)
  isVeg                  Boolean           @default(true) @map("is_veg")
  isPerishable           Boolean           @default(false) @map("is_perishable")
  preparationTimeMinutes Int               @default(10) @map("preparation_time_minutes")
  imageUrl               String?           @map("image_url") @db.Text
  hsnSacCode             String?           @map("hsn_sac_code") @db.VarChar(20)
  gstRatePercentage      Decimal           @default(5.00) @map("gst_rate_percentage") @db.Decimal(5, 2)
  isActive               Boolean           @default(true) @map("is_active")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category               Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations           ItemTranslation[]
  variants               ItemVariant[]
  inventory              Inventory[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  reservations           InventoryReservation[]

  @@map("items")
}

model ItemTranslation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  languageCode String   @map("language_code") @db.VarChar(10)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, languageCode])
  @@map("item_translations")
}

model ItemVariant {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId            String     @map("item_id") @db.Uuid
  variantName       String     @map("variant_name") @db.VarChar(100)
  additionalPriceInr Decimal   @default(0.00) @map("additional_price_inr") @db.Decimal(10, 2)
  isAvailable       Boolean    @default(true) @map("is_available")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  item              Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cartItems         CartItem[]

  @@map("item_variants")
}

model Inventory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String   @map("outlet_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  stockQuantity     Int      @default(0) @map("stock_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  isInStock         Boolean  @default(true) @map("is_in_stock")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet            Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item              Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([outletId, itemId])
  @@map("inventory")
}

model InventoryReservation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutSessionId String   @map("checkout_session_id") @db.Uuid
  outletId          String   @map("outlet_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  quantity          Int
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  status            String   @default("RESERVED") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  outlet            Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  item              Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("inventory_reservations")
}

// ------------------------------------------------------------------------------
// 4. Partners, Vehicles, Modes & Generic Dispatch Feed (Section 5B)
// ------------------------------------------------------------------------------

model Partner {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                  @map("user_id") @db.Uuid
  status             String                  @default("REGISTERED") @db.VarChar(32)
  backgroundChecked  Boolean                 @default(false) @map("background_checked")
  equipmentVerified  Boolean                 @default(false) @map("equipment_verified")
  bankAccountNumber  String?                 @map("bank_account_number") @db.VarChar(50)
  bankIfsc           String?                 @map("bank_ifsc") @db.VarChar(20)
  bankBeneficiaryName String?                @map("bank_beneficiary_name") @db.VarChar(255)
  cashInHandInr      Decimal                 @default(0.00) @map("cash_in_hand_inr") @db.Decimal(10, 2)
  cashInHandLimitInr Decimal                 @default(2000.00) @map("cash_in_hand_limit_inr") @db.Decimal(10, 2)
  ratingAverage      Decimal                 @default(5.00) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int                     @default(0) @map("rating_count")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicles           Vehicle[]
  documents          PartnerDocument[]
  partnerMode        PartnerMode?
  jobs               PartnerJob[]
  locationHistory    PartnerLocationHistory[]
  deliveryLegs       DeliveryLeg[]

  @@map("partners")
}

model Vehicle {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId                String   @map("partner_id") @db.Uuid
  vehicleType              String   @map("vehicle_type") @db.VarChar(32)
  registrationNumber       String   @unique @map("registration_number") @db.VarChar(30)
  makeModel                String   @map("make_model") @db.VarChar(100)
  rcVerified               Boolean  @default(false) @map("rc_verified")
  insuranceVerified        Boolean  @default(false) @map("insurance_verified")
  commercialPermitVerified Boolean  @default(false) @map("commercial_permit_verified")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner                  Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model PartnerDocument {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId          String    @map("partner_id") @db.Uuid
  documentType       String    @map("document_type") @db.VarChar(50)
  documentNumber     String?   @map("document_number") @db.VarChar(100)
  fileUrl            String    @map("file_url") @db.Text
  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(32)
  rejectionReason    String?   @map("rejection_reason") @db.Text
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  partner            Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_documents")
}

model PartnerMode {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId          String   @unique @map("partner_id") @db.Uuid
  currentMode        String   @default("DELIVERIES_ONLY") @map("current_mode") @db.VarChar(32)
  isOnline           Boolean  @default(false) @map("is_online")
  activeVerticalLock String?  @map("active_vertical_lock") @db.VarChar(32)
  lastModeSwitchAt   DateTime @default(now()) @map("last_mode_switch_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner            Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_modes")
}

model PartnerJob {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType              String                  @map("job_type") @db.VarChar(32)
  entityId             String                  @map("entity_id") @db.Uuid
  partnerId            String?                 @map("partner_id") @db.Uuid
  status               String                  @default("OFFERED") @db.VarChar(32)
  pickupLocation       Unsupported("geometry(Point, 4326)") @map("pickup_location")
  dropLocation         Unsupported("geometry(Point, 4326)") @map("drop_location")
  pickupAddress        String                  @map("pickup_address") @db.Text
  dropAddress          String                  @map("drop_address") @db.Text
  estimatedEarningsInr Decimal                 @map("estimated_earnings_inr") @db.Decimal(10, 2)
  offeredAt            DateTime                @default(now()) @map("offered_at") @db.Timestamptz(6)
  expiresAt            DateTime                @map("expires_at") @db.Timestamptz(6)
  acceptedAt           DateTime?               @map("accepted_at") @db.Timestamptz(6)
  completedAt          DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner              Partner?                @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  locationHistory      PartnerLocationHistory[]

  @@map("partner_jobs")
}

model PartnerLocationHistory {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String      @map("partner_id") @db.Uuid
  activeJobId String?     @map("active_job_id") @db.Uuid
  location    Unsupported("geometry(Point, 4326)")
  speedKph    Decimal?    @map("speed_kph") @db.Decimal(5, 2)
  bearing     Decimal?    @db.Decimal(5, 2)
  recordedAt  DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(6)

  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  activeJob   PartnerJob? @relation(fields: [activeJobId], references: [id], onDelete: SetNull)

  @@map("partner_location_history")
}

// ------------------------------------------------------------------------------
// 5. Carts, Checkout Sessions & Order Decomposition (Section 5A)
// ------------------------------------------------------------------------------

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String     @unique @map("customer_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
