{
  "name": "@allgo/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "AllGo Shared Design System, UI Components, Themes, and Hugeicons",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./icons": "./src/icons/index.ts",
    "./styles.css": "./src/theme/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
