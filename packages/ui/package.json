    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.79.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
