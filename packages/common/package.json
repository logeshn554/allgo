{
  "name": "@allgo/common",
  "version": "0.1.0",
  "type": "module",
  "description": "AllGo Shared Domain Types, Enums, and Constants",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./enums/*": {
      "types": "./dist/enums/*.d.ts",
      "import": "./dist/enums/*.js",
      "default": "./dist/enums/*.js"
    },
    "./i18n/*": {
      "types": "./dist/i18n/*.d.ts",
      "import": "./dist/i18n/*.js",
      "default": "./dist/i18n/*.js"
    }
  }
}
