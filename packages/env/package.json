{
  "name": "@allgo/env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed Zod v4 environment validation for AllGo services and apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@allgo/config-typescript": "workspace:*"
  }
}
