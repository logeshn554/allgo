{
  "name": "@allgo/monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@allgo/monorepo",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "@redocly/cli": "^2.75.0"
      }
    },
    "apps/admin": {
      "name": "@allgo/admin",
      "version": "0.1.0",
      "dependencies": {
        "@allgo/common": "*"
      }
    },
    "apps/api": {
      "name": "@allgo/api",
      "version": "0.1.0",
      "dependencies": {
        "@allgo/common": "*"
      }
    },
    "apps/dispatch": {
      "name": "@allgo/dispatch",
      "version": "0.1.0",
      "dependencies": {
        "@allgo/common": "*"
      }
    },
    "apps/webhooks": {
      "name": "@allgo/webhooks",
      "version": "0.1.0",
      "dependencies": {
        "@allgo/common": "*"
      }
    },
    "node_modules/@allgo/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/@allgo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@allgo/common": {
      "resolved": "packages/common",
      "link": true
    },
    "node_modules/@allgo/dispatch": {
      "resolved": "apps/dispatch",
      "link": true
    },
    "node_modules/@allgo/webhooks": {
      "resolved": "apps/webhooks",
      "link": true
    },
    "node_modules/@redocly/cli": {
      "version": "2.75.0",
      "resolved": "https://registry.npmjs.org/@redocly/cli/-/cli-2.75.0.tgz",
      "integrity": "sha512-jShlmyHydk8i8bGvvkLDhfKOwAnACG5s1Okwv+S323OoFUajOLOy1uOfNIiEAIZZIaLreoatkvXYcdavc0u9RQ==",
      "dev": true,
      "license": "MIT",
      "bin": {
        "openapi": "bin/cli.js",
        "redocly": "bin/cli.js"
      },
      "engines": {
        "node": ">=22.12.0 || >=20.19.0 <21.0.0",
        "npm": ">=10"
      }
    },
    "packages/common": {
      "name": "@allgo/common",
      "version": "0.1.0"
    }
  }
}
