{
  "name": "@allgo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AllGo Core API Service (NestJS REST API)",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'),cp=require('child_process');if(!fs.existsSync('../../packages/common/dist/index.d.ts')){cp.execSync('npm run build --workspace=@allgo/common',{stdio:'inherit'})}\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint {҂.ts,҂.tsx,҂.d.ts} --fix --config .eslintrc.js"
  },
  "dependencies": {
    "@allgo/common": "*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/platform-socket.io": "^12.4.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/websockets": "^12.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "arctic": "^3.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.5.1",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  }
}
