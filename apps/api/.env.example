# ==============================================================================
# AllGo Core API Service (apps/api) Environment Configuration Template
# ==============================================================================
# Note: Copy this file to .env or .env.local for local development.
# In Cloud Run environments, secrets are injected via Google Secret Manager (--set-secrets).
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Primary Relational Database (PostgreSQL 15 + PostGIS)
# In production, Cloud SQL Auth Proxy / Private IP socket connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allgo_dev?schema=public

# In-Memory Cache & Ephemeral Real-Time State (Memorystore Redis 7.0)
REDIS_URL=redis://localhost:6379

# RS256 Asymmetric Keypair for Auth Session JWT Minting and Verification
# Base64 encoded or multi-line PEM format
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_pem\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_rsa_public_key_pem\n-----END PUBLIC KEY-----"

# Firebase Admin SDK Credentials (JSON payload or base64 encoded string)
FIREBASE_SERVICE_ACCOUNT_KEY="your_firebase_service_account_json_or_base64"

# Razorpay Standard & Route Marketplace Split Settlement Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps Platform Server-Side API Key (Routes API, Geocoding, Places)
# Restricted to server egress IP in GCP Console
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key
