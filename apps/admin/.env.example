# ==============================================================================
# AllGo Back-Office Admin Portal API (apps/admin) Environment Configuration Template
# ==============================================================================
# Note: Copy this file to .env or .env.local for local development.
# In Cloud Run environments, secrets are injected via Google Secret Manager (--set-secrets).
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3003

# Primary Relational Database (PostgreSQL 15 + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allgo_dev?schema=public

# In-Memory Cache & Session Management
REDIS_URL=redis://localhost:6379

# RS256 Asymmetric Keypair for Admin Session Authentication
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_pem\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_rsa_public_key_pem\n-----END PUBLIC KEY-----"

# Firebase Admin SDK Credentials (JSON payload or base64 encoded string)
FIREBASE_SERVICE_ACCOUNT_KEY="your_firebase_service_account_json_or_base64"
