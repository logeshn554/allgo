{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@allgo/common": ["./packages/common/src/index.ts"],
      "@allgo/common/*": ["./packages/common/src/*"],
      "@allgo/env": ["./packages/env/src/index.ts"],
      "@allgo/api-client": ["./packages/api-client/src/index.ts"],
      "@allgo/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
